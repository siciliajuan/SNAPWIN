/*
 * EN.RC - English (default and fallback language).

 * To add a translation, copy this file to <code>.rc, translate the
 * quoted texts and follow README.md, "Adding a translation".
 * Encoding: Windows-1252 (ANSI), the native code page of Windows 3.1.
 *
 * Included by each binary's .rc, which defines RC_SNAPCPL, RC_SETUP or
 * RC_SNAPWIN to select its section. "%s" marks are filled in at run time;
 * keep them, in the same order. "\n" is a line break.
 * Win16 limits each string to 255 characters: split longer texts (as
 * IDS_SETUP_DONE/IDS_SETUP_DONE2). tests/langtest.c checks this.
 *
 * Copyright (c) 2026 Juan Sicilia
 * SPDX-License-Identifier: MIT
 */
#undef  L_STR
#undef  L_DLG
#define L_STR  (LANG_EN * LANG_STRIDE)   /* string ID offset */
#define L_DLG  LANG_EN                   /* dialog ID offset */

STRINGTABLE
BEGIN
    L_STR + IDS_LANG_NAME, "English"   /* this language, in this language */
END

#ifdef RC_SNAPCPL
STRINGTABLE
BEGIN
    L_STR + IDS_CPL_NAME,      "SnapWin"
    L_STR + IDS_CPL_INFO,      "Snaps windows to half or a quarter of the screen"
    L_STR + IDS_CPL_CAPTION,   "SnapWin %s - Window Snapping"
    L_STR + IDS_CPL_LICENSE,   "%s - MIT License"
    L_STR + IDS_CPL_RUNNING,   "Status: SnapWin is running."
    L_STR + IDS_CPL_STOPPED,   "Status: SnapWin is not running (it will be started when you click OK)."
    L_STR + IDS_CPL_ERR_NOMOD, "The %s shortcut must include Ctrl or Alt;\notherwise that key would stop working in every program."
    L_STR + IDS_CPL_ERR_DUP,   "The %s and %s shortcuts are the same."
    L_STR + IDS_CPL_LANG_AUTO, "Automatic (Windows setting)"

    /* Row names, as they appear inside IDS_CPL_ERR_NOMOD / IDS_CPL_ERR_DUP */
    L_STR + IDS_CPL_ROW_BASE + 0, "left half"
    L_STR + IDS_CPL_ROW_BASE + 1, "right half"
    L_STR + IDS_CPL_ROW_BASE + 2, "top-left quarter"
    L_STR + IDS_CPL_ROW_BASE + 3, "top-right quarter"
    L_STR + IDS_CPL_ROW_BASE + 4, "bottom-left quarter"
    L_STR + IDS_CPL_ROW_BASE + 5, "bottom-right quarter"
    L_STR + IDS_CPL_ROW_BASE + 6, "maximize"
    L_STR + IDS_CPL_ROW_BASE + 7, "restore"
    L_STR + IDS_CPL_ROW_BASE + 8, "minimize"

    /* Key names, in the order of g_keys[] in snapcpl.c */
    L_STR + IDS_KEY_BASE + 0 , "(none)"
    L_STR + IDS_KEY_BASE + 1 , "Left Arrow"
    L_STR + IDS_KEY_BASE + 2 , "Right Arrow"
    L_STR + IDS_KEY_BASE + 3 , "Up Arrow"
    L_STR + IDS_KEY_BASE + 4 , "Down Arrow"
    L_STR + IDS_KEY_BASE + 5 , "Home"
    L_STR + IDS_KEY_BASE + 6 , "End"
    L_STR + IDS_KEY_BASE + 7 , "Page Up"
    L_STR + IDS_KEY_BASE + 8 , "Page Down"
    L_STR + IDS_KEY_BASE + 9 , "Insert"
    L_STR + IDS_KEY_BASE + 10, "Delete"
    L_STR + IDS_KEY_BASE + 11, "F1"
    L_STR + IDS_KEY_BASE + 12, "F2"
    L_STR + IDS_KEY_BASE + 13, "F3"
    L_STR + IDS_KEY_BASE + 14, "F4"
    L_STR + IDS_KEY_BASE + 15, "F5"
    L_STR + IDS_KEY_BASE + 16, "F6"
    L_STR + IDS_KEY_BASE + 17, "F7"
    L_STR + IDS_KEY_BASE + 18, "F8"
    L_STR + IDS_KEY_BASE + 19, "F9"
    L_STR + IDS_KEY_BASE + 20, "F10"
    L_STR + IDS_KEY_BASE + 21, "F11"
    L_STR + IDS_KEY_BASE + 22, "F12"
    L_STR + IDS_KEY_BASE + 23, "Numpad 7"
    L_STR + IDS_KEY_BASE + 24, "Numpad 9"
    L_STR + IDS_KEY_BASE + 25, "Numpad 1"
    L_STR + IDS_KEY_BASE + 26, "Numpad 3"
    L_STR + IDS_KEY_BASE + 27, "Numpad 4"
    L_STR + IDS_KEY_BASE + 28, "Numpad 6"
END

IDD_CONFIG + L_DLG DIALOG 20, 4, 274, 260
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SnapWin"                 /* replaced at run time (IDS_CPL_CAPTION) */
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "When a window is dragged and dropped", -1, 6, 3, 262, 50
    CONTROL         "On the left or right edge: fill half of the screen",
                    IDC_DRAG, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 14, 250, 10
    CONTROL         "In a corner: fill that quarter of the screen",
                    IDC_CORNERS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 26, 250, 10
    CONTROL         "On the top edge: maximize the window",
                    IDC_MAXIMIZE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 38, 250, 10

    GROUPBOX        "Keyboard shortcuts (active window)", -1, 6, 58, 262, 141
    LTEXT           "Left half:", -1, 12, 73, 66, 8
    CONTROL         "Ctrl",  IDC_CTRL(0),  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 72, 26, 10
    CONTROL         "Alt",   IDC_ALT(0),   "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 108, 72, 22, 10
    CONTROL         "Shift", IDC_SHIFT(0), "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 132, 72, 34, 10
    COMBOBOX        IDC_KEY(0), 168, 71, 94, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Right half:", -1, 12, 87, 66, 8
    CONTROL         "Ctrl",  IDC_CTRL(1),  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 86, 26, 10
    CONTROL         "Alt",   IDC_ALT(1),   "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 108, 86, 22, 10
    CONTROL         "Shift", IDC_SHIFT(1), "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 132, 86, 34, 10
    COMBOBOX        IDC_KEY(1), 168, 85, 94, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Top left:", -1, 12, 101, 66, 8
    CONTROL         "Ctrl",  IDC_CTRL(2),  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 100, 26, 10
    CONTROL         "Alt",   IDC_ALT(2),   "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 108, 100, 22, 10
    CONTROL         "Shift", IDC_SHIFT(2), "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 132, 100, 34, 10
    COMBOBOX        IDC_KEY(2), 168, 99, 94, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Top right:", -1, 12, 115, 66, 8
    CONTROL         "Ctrl",  IDC_CTRL(3),  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 114, 26, 10
    CONTROL         "Alt",   IDC_ALT(3),   "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 108, 114, 22, 10
    CONTROL         "Shift", IDC_SHIFT(3), "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 132, 114, 34, 10
    COMBOBOX        IDC_KEY(3), 168, 113, 94, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Bottom left:", -1, 12, 129, 66, 8
    CONTROL         "Ctrl",  IDC_CTRL(4),  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 128, 26, 10
    CONTROL         "Alt",   IDC_ALT(4),   "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 108, 128, 22, 10
    CONTROL         "Shift", IDC_SHIFT(4), "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 132, 128, 34, 10
    COMBOBOX        IDC_KEY(4), 168, 127, 94, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Bottom right:", -1, 12, 143, 66, 8
    CONTROL         "Ctrl",  IDC_CTRL(5),  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 142, 26, 10
    CONTROL         "Alt",   IDC_ALT(5),   "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 108, 142, 22, 10
    CONTROL         "Shift", IDC_SHIFT(5), "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 132, 142, 34, 10
    COMBOBOX        IDC_KEY(5), 168, 141, 94, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Maximize:", -1, 12, 157, 66, 8
    CONTROL         "Ctrl",  IDC_CTRL(6),  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 156, 26, 10
    CONTROL         "Alt",   IDC_ALT(6),   "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 108, 156, 22, 10
    CONTROL         "Shift", IDC_SHIFT(6), "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 132, 156, 34, 10
    COMBOBOX        IDC_KEY(6), 168, 155, 94, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Restore:", -1, 12, 171, 66, 8
    CONTROL         "Ctrl",  IDC_CTRL(7),  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 170, 26, 10
    CONTROL         "Alt",   IDC_ALT(7),   "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 108, 170, 22, 10
    CONTROL         "Shift", IDC_SHIFT(7), "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 132, 170, 34, 10
    COMBOBOX        IDC_KEY(7), 168, 169, 94, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Minimize:", -1, 12, 185, 66, 8
    CONTROL         "Ctrl",  IDC_CTRL(8),  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 184, 26, 10
    CONTROL         "Alt",   IDC_ALT(8),   "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 108, 184, 22, 10
    CONTROL         "Shift", IDC_SHIFT(8), "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 132, 184, 34, 10
    COMBOBOX        IDC_KEY(8), 168, 183, 94, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Language:", -1, 8, 207, 60, 8
    COMBOBOX        IDC_LANG, 70, 205, 120, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "", IDC_STATUS, 6, 221, 262, 16
    LTEXT           "", IDC_COPYRIGHT, 6, 243, 148, 8, WS_DISABLED
    DEFPUSHBUTTON   "OK", IDOK, 158, 240, 52, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 216, 240, 52, 14
END
#endif /* RC_SNAPCPL */

#ifdef RC_SETUP
STRINGTABLE
BEGIN
    L_STR + IDS_SETUP_TITLE,     "SnapWin Setup"
    L_STR + IDS_SETUP_NEEDWIN31, "SnapWin requires Windows 3.1 or later."
    L_STR + IDS_SETUP_ASK,       "Install SnapWin %s?\n\nSnaps windows to half or a quarter of the screen\non Windows 3.1x.\n\n%s\nFree software, MIT License."
    L_STR + IDS_SETUP_ALREADY,   "SnapWin is already installed.\n\nYes = Reinstall / upgrade to %s\nNo = Uninstall\nCancel = Exit"
    L_STR + IDS_SETUP_COPYFAIL,  "The files could not be copied to the Windows SYSTEM directory.\nMake sure SNAPHOOK.DLL, SNAPWIN.EXE and SNAPCFG.CPL are in the same directory as SETUP.EXE."
    L_STR + IDS_SETUP_DONE,      "SnapWin has been installed and is now running.\n\n- Drag a window to the left or right edge: half screen.\n- Drag it into a corner: quarter screen.\n- Drag it to the top edge: maximize."
    L_STR + IDS_SETUP_DONE2,     "\n- Ctrl+Alt+Left / Right Arrow: halves.\n- Ctrl+Alt+Home / Page Up / End / Page Down: quarters.\n- Ctrl+Alt+F / R / Down Arrow: maximize / restore / minimize."   /* appended to IDS_SETUP_DONE */
    L_STR + IDS_SETUP_DONE3,     "\n\nYou can change the shortcuts in Control Panel (SnapWin icon).\nSnapWin will start automatically every time Windows starts."   /* appended after IDS_SETUP_DONE2 */
    L_STR + IDS_SETUP_REMOVED,   "SnapWin has been uninstalled."
    L_STR + IDS_SETUP_PARTIAL,   "SnapWin has been disabled, but some files could not be deleted.\nClose Control Panel and run SETUP.EXE again."
END
#endif /* RC_SETUP */

#ifdef RC_SNAPWIN
STRINGTABLE
BEGIN
    L_STR + IDS_SNAP_NOHOOKS, "Could not install the system hooks.\nSnapWin requires Windows 3.1 or later."
END
#endif /* RC_SNAPWIN */
